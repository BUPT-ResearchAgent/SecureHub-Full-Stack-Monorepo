{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": ".build",
    "noEmitOnError": true,
    "lib": ["ES2020", "DOM"]
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts"]
}
