# === LLM ===
XFYUN_APPID=__FILL_ME__
XFYUN_APP_ID=__FILL_ME__
XFYUN_API_KEY=__FILL_ME__
XFYUN_API_SECRET=__FILL_ME__
XFYUN_SPARK_DOMAIN=4.0Ultra
# Spark X2 Flash: https://spark-api-open.xf-yun.com/agent/v1 + spark-x
XFYUN_BASE_URL=https://spark-api-open.xf-yun.com/v1
XFYUN_MODEL=spark-v4
# Spark X2 enables reasoning by default; use disabled for strict JSON workflows.
XFYUN_THINKING_MODE=
XFYUN_TTS_APP_ID=__FILL_ME__
XFYUN_TTS_API_KEY=__FILL_ME__
XFYUN_TTS_API_SECRET=__FILL_ME__
DEEPSEEK_API_KEY=                       # 可空，空则不启用 fallback
DEEPSEEK_MODEL=deepseek-chat
# === Agent Run strict real mode (default disabled; never put a key here) ===
AGENT_RUN_REAL_ENABLED=false
AGENT_RUN_REAL_MAX_CONCURRENCY=1
AGENT_RUN_REAL_MAX_TOKENS=800
AGENT_RUN_EVENT_HISTORY_LIMIT=2048
AGENT_RUN_EVENT_SUBSCRIBER_QUEUE_LIMIT=256
AGENT_RUN_COMPLETED_TTL_SECONDS=3600
QWEN_API_KEY=                           # 可空
LLM_PROVIDER=xfyun
LLM_PRIMARY=xfyun
LLM_FALLBACK_CHAIN=deepseek,qwen,mock   # 逗号分隔；mock 仅 dev

# === Embedding ===
EMBEDDING_PROVIDER=qwen_openai_compatible
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024                      # 与 chunks.embedding VECTOR(N) 一致；改值要重建 HNSW
EMBEDDING_PROFILE=qwen-openai-compatible:text-embedding-v4:1024:dense:v1
EMBEDDING_BATCH_SIZE=10
EMBEDDING_MAX_CONCURRENCY=1
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=2
EMBEDDING_OUTPUT_TYPE=dense
ENABLE_EMBEDDING_LIVE_TESTS=false
DASHSCOPE_API_KEY=
DASHSCOPE_OPENAI_COMPATIBLE_BASE_URL=

# === Database ===
DATABASE_URL=postgresql+asyncpg://securehub:securehub@localhost:5432/securehub
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=7
DATABASE_POOL_TIMEOUT_SECONDS=10
API_RISK_AUDIT_POOL_SIZE=20
API_RISK_AUDIT_MAX_CONCURRENCY=10
REDIS_URL=redis://localhost:6379/0

# === Storage ===
STORAGE_PROVIDER=local                  # local | minio | s3 | oss | cos | r2
STORAGE_LOCAL_ROOT=./data/storage
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-beijing
COS_BUCKET=
COS_SCHEME=https
COS_PRESIGNED_EXPIRES_SECONDS=600
COS_UPLOAD_MAX_BYTES=104857600
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=securehub

# === Upload Gate ===
UPLOAD_GATE_ENABLED=true
UPLOAD_GATE_SECRET_HASH=
UPLOAD_GATE_MAX_BYTES=104857600
UPLOAD_GATE_ALLOWED_MIME_PREFIXES=image/,application/pdf,text/markdown
UPLOAD_GATE_ALLOWED_PREFIXES=uploads/,tmp/uploads/
UPLOAD_GATE_PRESIGNED_EXPIRES_SECONDS=600

# === MinerU ===
MINERU_MODE=manual                      # api | local | manual
MINERU_API_BASE=
MINERU_API_KEY=
MINERU_LOCAL_BIN=

# === Harness ===
HARNESS_MIN_EVIDENCE=3
HARNESS_TIMEOUT_SECONDS=60
HARNESS_DEFAULT_RETRY_MAX=1
HARNESS_MOCK_MODE=false                 # true 时 LLM/Retriever 走 fixtures
MIN_EVIDENCE=3
RETRIEVAL_TOP_K=8
RERANK_TOP_K=5

# === Crawling（成员 C 用；离线任务，非在线服务）===
CRAWL_RESPECT_ROBOTS=true
CRAWL_DEFAULT_DELAY_SECONDS=2
CRAWL_MAX_CONCURRENCY=2
CRAWL_USER_AGENT=SecureHub-Edu-Crawler/0.1 (compliance@securehub.local)

# === App ===
APP_NAME=securehub-backend
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
API_V1_PREFIX=/api/v1
FRONTEND_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
DEBUG=true
